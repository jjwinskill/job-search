#!/bin/sh
# Blocks a push that would publish personal data. See scripts/scan-personal-data.mjs.
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  node "$root/scripts/scan-personal-data.mjs" --rev "$local_sha" || status=1
  node "$root/scripts/scan-personal-data.mjs" --new-commits "$local_sha" || status=1
done
exit $status
