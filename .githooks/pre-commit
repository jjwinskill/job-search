#!/bin/sh
# Runs the tests and the personal-data scan before every commit, so neither gets skipped.
cd "$(git rev-parse --show-toplevel)" || exit 1
# The tests create their own git repos; git's hook variables would point them at this repo's index.
env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX node --test --test-reporter=dot ||
  { echo "pre-commit: tests failed. Run npm test for details." >&2; exit 1; }
node scripts/scan-personal-data.mjs --staged && node scripts/scan-personal-data.mjs
